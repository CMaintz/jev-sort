{
  "name": "jev-sort",
  "version": "1.0.0",
  "description": "jq for judgment — stream rows through TypeSafe AI Jev and get typed classification/score columns + confidence, at pennies per 10k.",
  "license": "MIT",
  "author": "Christoffer Maintz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CMaintz/jev-sort.git"
  },
  "homepage": "https://github.com/CMaintz/jev-sort#readme",
  "bugs": {
    "url": "https://github.com/CMaintz/jev-sort/issues"
  },
  "type": "module",
  "sideEffects": false,
  "bin": {
    "jev-sort": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check \"**/*.ts\"",
    "format": "prettier --write \"**/*.ts\" && eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "jev",
    "typesafe",
    "llm",
    "classification",
    "bulk",
    "cli",
    "data-labeling",
    "etl",
    "jq"
  ],
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.7.0",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^9.36.0",
    "jscpd": "^5.3.2",
    "knip": "^6.37.0",
    "prettier": "^3.3.3",
    "ts-morph": "^28.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.40.0",
    "vitest": "^5.0.1"
  }
}
